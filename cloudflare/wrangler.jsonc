{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bhsbot",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bhsbot-db",
      // Placeholder. Real D1 ids belong in local or CI config, not this public file.
      // Replace with the id from `npx wrangler d1 create bhsbot-db` (or the dashboard) before remote migrations or deploy.
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "DEEPSEEK_MODEL": "deepseek-v4-flash",
    "BHS_ENVIRONMENT": "production"
  }
}
